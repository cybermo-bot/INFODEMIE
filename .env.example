# Copy to .env and fill in. Never commit .env.
# Missing optional keys disable the related connector ("non configuré"); they never crash the app.

# Core
APP_ENV=dev
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DEFAULT_LOCALE=fr
DEFAULT_TIMEZONE=Africa/Tunis
DATABASE_URL=postgresql+psycopg://pnsi:pnsi@localhost:5433/pnsi
TEST_DATABASE_URL=postgresql+psycopg://pnsi:pnsi@localhost:5433/pnsi_test
REDIS_URL=redis://localhost:6379/0
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Leave empty to use <repo>/data
DATA_DIR=
LOG_LEVEL=INFO

# Sessions (decision D13)
SESSION_IDLE_HOURS=12
SESSION_MAX_HOURS=168
# Web app: where the Next.js server forwards /api/* (server side only)
API_INTERNAL_URL=http://127.0.0.1:8000

# AI (decision D5)
AI_MODE=hybrid                 # hybrid | local
EXTERNAL_AI_ENABLED=true       # only redacted public text is ever sent
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
LOCAL_CHAT_MODEL=qwen3:4b-instruct
AI_DAILY_BUDGET_GEMINI_REQUESTS=
AI_DAILY_BUDGET_GROQ_REQUESTS=

# Google (one key restricted to YouTube Data API v3 and Fact Check Tools API)
GOOGLE_API_KEY=
YOUTUBE_DAILY_UNIT_BUDGET=9000

# Telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_BOT_TOKEN=

# Social routes (decision D4)
APIFY_TOKEN=
APIFY_MAX_SPEND_USD=5
FACEBOOK_PAGE_TOKENS=          # comma-separated page_id:token pairs, provided by page admins
META_APP_ID=
META_APP_SECRET=

# Optional sources
BLUESKY_BASE_URL=https://public.api.bsky.app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=pnsi/0.1 (public health monitoring)

# Evidence discovery
NCBI_EMAIL=
NCBI_API_KEY=
NCBI_TOOL=pnsi

# Governance
AUTO_PUBLISH_ENABLED=false
RAW_RETENTION_HOURS=24
REDACTED_RETENTION_DAYS=90

# Email (Mailpit in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=pnsi@localhost
